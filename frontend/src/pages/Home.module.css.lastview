587: /* ─── ANIMATIONS ─── */
588: @keyframes heartbeat { 
589:   0% { transform: translateY(8%) scale(2.4); filter: brightness(1); } 
590:   15% { transform: translateY(8%) scale(2.5); filter: brightness(1.2); } 
591:   30% { transform: translateY(8%) scale(2.4); filter: brightness(1); } 
592:   45% { transform: translateY(8%) scale(2.45); filter: brightness(1.15); } 
593:   100% { transform: translateY(8%) scale(2.4); filter: brightness(1); } 
594: }
595: @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
596: @keyframes spin-reverse { 0% { transform: rotate(360deg); } 100% { transform: rotate(0deg); } }
597: @keyframes fadeDown { 0% { opacity: 0; transform: translateY(-20px); } 100% { opacity: 1; transform: translateY(0); } }
598: @keyframes fadeUp { 0% { opacity: 0; transform: translateY(20px); } 100% { opacity: 1; transform: translateY(0); } }
599: 
600: @keyframes heartbeat3D { 
601:   0% { transform: scale(1); filter: brightness(1) drop-shadow(0 0 35px rgba(0, 180, 255, 0.6)); } 
602:   15% { transform: scale(1.05); filter: brightness(1.2) drop-shadow(0 0 50px rgba(0, 210, 255, 0.9)); } 
603:   30% { transform: scale(1); filter: brightness(1) drop-shadow(0 0 35px rgba(0, 180, 255, 0.6)); } 
604:   45% { transform: scale(1.03); filter: brightness(1.15) drop-shadow(0 0 45px rgba(0, 210, 255, 0.8)); } 
605:   100% { transform: scale(1); filter: brightness(1) drop-shadow(0 0 35px rgba(0, 180, 255, 0.6)); } 
606: }
607: 
608: @keyframes heartbeat3DDay { 
609:   0% { transform: scale(1); filter: brightness(1) drop-shadow(0 0 35px rgba(0, 0, 0, 0.4)); } 
610:   15% { transform: scale(1.05); filter: brightness(1.1) drop-shadow(0 0 55px rgba(0, 0, 0, 0.65)); } 
611:   30% { transform: scale(1); filter: brightness(1) drop-shadow(0 0 35px rgba(0, 0, 0, 0.4)); } 
612:   45% { transform: scale(1.03); filter: brightness(1.05) drop-shadow(0 0 45px rgba(0, 0, 0, 0.55)); } 
613:   100% { transform: scale(1); filter: brightness(1) drop-shadow(0 0 35px rgba(0, 0, 0, 0.4)); } 
614: }
