# Environment
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/organ-transport

# JWT & Auth
JWT_SECRET=change-me-to-a-strong-random-string
# 2FA: set to 'true' in production to enforce TOTP for high-privilege roles
ENFORCE_2FA=false

# Blockchain / Audit
BLOCKCHAIN_ENABLED=true
# Add any blockchain-specific config here (e.g., endpoint URLs, credentials)

# Compliance Cron (THOTA expiry)
ENABLE_COMPLIANCE_CRON=true

# Email / Notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=change-me
FROM_EMAIL=notifications@example.com

# Rate Limiting (optional overrides)
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_CRITICAL_MAX=10
