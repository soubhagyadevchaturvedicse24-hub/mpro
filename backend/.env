PORT=5000
# Using local WiredTiger persistent DB (Atlas unreachable in demo environment)
MONGODB_URI=local
JWT_SECRET=supersecretkey_organshield_2026
NODE_ENV=development
# Use mini blockchain adapter (MongoDB-backed) — no Ganache required
BLOCKCHAIN_ADAPTER=mini

# Ethereum / Ganache (not needed for demo — mini adapter is active)
GANACHE_RPC_URL=http://127.0.0.1:8545
GANACHE_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d
GANACHE_CONTRACT_ADDRESS=0xe78A0F7E598Cc8b0Bb87894B0F60dD2a88d6a8Ab

# AES-256-GCM field encryption key (32 bytes = 64 hex chars)
FIELD_ENCRYPTION_KEY=7d3c46fe74cf5ba90c84e058f215d73d3050441ac92887ea37f213a29bf7f037

# Account lockout policy
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Disable compliance cron for demo
ENABLE_COMPLIANCE_CRON=false
